package {
    default_applicable_licenses: [
        "packages_services_CrossDeviceSync_license",
    ],
}

license {
    name: "packages_services_CrossDeviceSync_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

android_app {
    name: "CrossDeviceSync",
    defaults: ["platform_app_defaults"],
    certificate: "platform",
    privileged: true,
    srcs: ["src/**/*.java"],
    static_libs: [
        "androidx.annotation_annotation",
        "androidx.room_room-runtime",
        "com_android_crossdevicesync_flags_lib",
        "dagger2",
        "data-protos-lite",
        "error_prone_annotations",
        "guava",
        "jsr330",
        "submerge_java",
    ],
    required: ["submerge_java_shared"],
    platform_apis: true,
    generate_product_characteristics_rro: true,
    dex_preopt: {
        enabled: true,
    },
    optimize: {
        optimize: true,
        optimized_shrink_resources: true,
    },
    plugins: [
        "androidx.room_room-compiler-plugin",
        "dagger2-compiler",
    ],
    javacflags: [
        "-Adagger.fastInit=enabled",
        "-J-Xmx8192M",
        "-Adagger.explicitBindingConflictsWithInject=ERROR",
        "-Adagger.strictMultibindingValidation=enabled",
        "-Aroom.schemaLocation=packages/services/CrossDeviceSync/schemas",
    ],
}

android_test {
    name: "CrossDeviceSyncTests",
    defaults: ["platform_app_defaults"],
    certificate: "platform",
    srcs: [
        "src/**/*.java",
        "tests/src/**/*.java",
    ],
    static_libs: [
        "androidx.annotation_annotation",
        "androidx.room_room-runtime",
        "androidx.test.ext.junit",
        "androidx.test.rules",
        "androidx.test.core",
        "com_android_crossdevicesync_flags_lib",
        "data-protos-lite",
        "error_prone_annotations",
        "flag-junit",
        "mockito-target-minus-junit4",
        "submerge_java",
        "truth",
        "dagger2",
        "jsr330",
    ],
    jni_libs: [
        "submerge_java_shared",
    ],
    platform_apis: true,
    test_suites: ["device-tests"],
    test_config: "tests/AndroidTest.xml",
    manifest: "tests/AndroidManifest.xml",
    additional_manifests: ["AndroidManifest.xml"],
    plugins: [
        "androidx.room_room-compiler-plugin",
        "dagger2-compiler",
    ],
    javacflags: [
        "-Adagger.fastInit=enabled",
        "-J-Xmx8192M",
        "-Adagger.explicitBindingConflictsWithInject=ERROR",
        "-Adagger.strictMultibindingValidation=enabled",
        "-Aroom.schemaLocation=packages/services/CrossDeviceSync/schemas",
    ],
}
