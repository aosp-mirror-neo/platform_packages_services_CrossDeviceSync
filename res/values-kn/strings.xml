    <string name="app_label" msgid="8317618268687481611">"ಕ್ರಾಸ್-ಸಾಧನ ಸಿಂಕ್"</string>
    <string name="airplane_mode_sync_notification_channel_name" msgid="6564497319920541027">"ಏರ್‌ಪ್ಲೇನ್ ಮೋಡ್ ಸಿಂಕ್"</string>
    <string name="airplane_mode_sync_notification_title" msgid="7088001983683120469">"ಏರ್‌ಪ್ಲೇನ್ ಮೋಡ್"</string>
    <string name="airplane_mode_sync_notification_content" msgid="9114975580468630060">"ಏರ್‌ಪ್ಲೇನ್ ಮೋಡ್ ಈಗ ನಿಮ್ಮ ಫೋನ್ ಮತ್ತು ವಾಚ್‌ನಾದ್ಯಂತ ಸಿಂಕ್ ಆಗುತ್ತದೆ.\n\nನಿಮ್ಮ ವಾಚ್ ಮತ್ತು ಫೋನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಮೋಡ್ ಸಿಂಕ್ ಆದ್ಯತೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ."</string>
    <string name="apm_sync_notification_settings_action" msgid="5047802942977350991">"ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ"</string>
    <string name="do_not_disturb_sync_notification_channel_name" msgid="2633023256459106594">"ಅಡಚಣೆ ಮಾಡಬೇಡಿ ಫೀಚರ್ ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ"</string>
    <string name="do_not_disturb_sync_notification_title" msgid="6289972027187909815">"ಅಡಚಣೆ ಮಾಡಬೇಡಿ"</string>
    <string name="do_not_disturb_sync_notification_content" msgid="3277535522068446603">"ನಿಮ್ಮ ಸಮೀಪದ ಸಾಧನದಿಂದ ಸಿಂಕ್ ಮಾಡಲಾಗಿದೆ"</string>
</resources>
