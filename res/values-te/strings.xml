    <string name="app_label" msgid="8317618268687481611">"క్రాస్-డివైజ్ సింక్"</string>
    <string name="airplane_mode_sync_notification_channel_name" msgid="6564497319920541027">"విమానం మోడ్ సింక్ అయింది"</string>
    <string name="airplane_mode_sync_notification_title" msgid="7088001983683120469">"విమానం మోడ్"</string>
    <string name="airplane_mode_sync_notification_content" msgid="9114975580468630060">"విమానం మోడ్ ఇప్పుడు మీ ఫోన్, వాచ్ అంతటా సింక్ అవుతుంది.\n\nమీ వాచ్, ఫోన్ సెట్టింగ్‌లలో మోడ్ సింక్ ప్రాధాన్యతలను మేనేజ్ చేయండి."</string>
    <string name="apm_sync_notification_settings_action" msgid="5047802942977350991">"సెట్టింగ్‌లను మేనేజ్ చేయండి"</string>
    <string name="do_not_disturb_sync_notification_channel_name" msgid="2633023256459106594">"\'డిస్టర్బ్ చేయవద్దు\' సింక్"</string>
    <string name="do_not_disturb_sync_notification_title" msgid="6289972027187909815">"డిస్టర్బ్ చేయవద్దు"</string>
    <string name="do_not_disturb_sync_notification_content" msgid="3277535522068446603">"మీకు సమీపంలోని డివైజ్ నుండి సింక్ అయింది"</string>
</resources>
