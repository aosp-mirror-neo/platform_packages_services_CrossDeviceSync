    <string name="airplane_mode_sync_notification_title" msgid="7088001983683120469">"એરપ્લેન મોડ"</string>
    <string name="airplane_mode_sync_notification_content" msgid="9114975580468630060">"એરપ્લેન મોડ હવે તમારા ફોન અને વૉચ પર સિંક થશે.\n\nતમારી વૉચ અને ફોનના સેટિંગ પર મોડ સિંક કરવાની પસંદગીઓ મેનેજ કરો."</string>
    <string name="do_not_disturb_sync_notification_channel_name" msgid="2633023256459106594">"\'ખલેલ પાડશો નહીં\' સુવિધા સિંક કરો"</string>
