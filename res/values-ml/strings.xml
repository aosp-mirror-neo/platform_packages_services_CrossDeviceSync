    <string name="do_not_disturb_sync_notification_title" msgid="6289972027187909815">"ശല്യപ്പെടുത്തരുത്"</string>
    <string name="do_not_disturb_sync_notification_content" msgid="3277535522068446603">"സമീപമുള്ള ഉപകരണത്തിൽ നിന്ന് സമന്വയിപ്പിച്ചത്"</string>
